    "react-dom": "npm:@preact/compat@18.3.2"
  },
  "devDependencies": {
    "@lhci/cli": "0.16.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "shadcn": "^4.23.0",
